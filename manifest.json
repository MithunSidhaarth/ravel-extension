{
  "manifest_version": 3,
  "name": "Ravel",
  "short_name": "Ravel",
  "version": "0.2.0",
  "description": "Close any tab without losing your place. Ravel groups tabs into threads and keeps the ones you close searchable, all on your device.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/serviceWorker.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": ["alarms", "tabs", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
